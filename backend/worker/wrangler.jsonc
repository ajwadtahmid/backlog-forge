{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backlog-forge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Secrets (set with `npx wrangler secret put <NAME>`, never committed):
  //   STEAM_API_KEY  — Steam Web API key
  //   CLIENT_TOKEN   — shared token the app sends as X-Client-Token

  // Per-IP+SteamID limit on /user/library. The Worker skips the check if this
  // binding is removed. namespace_id: any positive integer unique in your account.
  "ratelimits": [
    {
      "name": "LIBRARY_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
